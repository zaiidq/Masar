# ------------------------------------------------------------
#  Masar — environment configuration
#
#  Copy this file to .env and fill in the real values.
#  .env is git-ignored and must never be committed.
#  It is also blocked from web access by .htaccess.
# ------------------------------------------------------------

# Database
DB_HOST=localhost
DB_NAME=masar_db
DB_USER=root
DB_PASSWORD=

# Google Gemini
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120

# Sessions: seconds of inactivity before a user is logged out (default 8 hours)
SESSION_LIFETIME=28800

# Ask Masar: maximum questions per student per day
CHAT_DAILY_LIMIT=30

# Login protection: failed attempts allowed per IP in 15 minutes
LOGIN_MAX_ATTEMPTS=5

# Email for "forgot password" links. Leave SMTP_HOST empty to switch
# email off: administrators then issue reset links from the Users page.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an "app password"
# (not your normal password) in SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Masar

# Public address of the site, used in emailed links. Needed behind a
# proxy such as Tailscale Funnel, e.g. https://server.tailnet.ts.net/masar
APP_URL=

# Set to 1 only when Masar runs behind a reverse proxy you control
# (Tailscale Funnel, nginx ...). The proxy's X-Forwarded-For is then
# trusted for the visitor's IP and X-Forwarded-Proto for HTTPS, which
# makes the login cookie HTTPS-only. Leave 0 when Apache is reached
# directly, because visitors could forge those headers.
TRUST_PROXY=0
