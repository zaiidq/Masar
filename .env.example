# ------------------------------------------------------------
#  Masar — environment configuration
#
#  Copy this file to .env and fill in the real values.
#  .env is git-ignored and must never be committed.
# ------------------------------------------------------------

# Database
DB_HOST=localhost
DB_NAME=masar_db
DB_USER=root
DB_PASSWORD=

# Google Gemini
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120
